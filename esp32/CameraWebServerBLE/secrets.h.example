/*
 * secrets.h - Configuration for the Sensor Tester ESP32-CAM BLE node.
 *
 * Instructions:
 * 1. Copy this file to CameraWebServerBLE/secrets.h
 * 2. Enter your real API key below.
 *
 * Note: the BLE node needs no Wi-Fi credentials and no TLS material —
 * the client authorizes by writing this key to the auth characteristic.
 */

#ifndef SECRETS_H
#define SECRETS_H

// Sensor API Key — clients must write this to the auth characteristic
const char *API_KEY = "your-sensor-api-key";  // At least 8 characters

#endif
