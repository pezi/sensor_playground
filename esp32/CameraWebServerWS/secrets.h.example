/*
 * secrets.h - Configuration for the Sensor Tester ESP32-CAM WebSocket node.
 *
 * Instructions:
 * 1. Copy this file to CameraWebServerWS/secrets.h
 * 2. Enter your real credentials below.
 *
 * Note: the node uses ws:// (no TLS) with the shared X-Api-Key handshake
 * header, so unlike the environment-sensor sketches it needs no
 * SERVER_CERT / SERVER_KEY.
 */

#ifndef SECRETS_H
#define SECRETS_H

// WiFi Configuration
const char *WIFI_SSID = "YOUR_WIFI_SSID";
const char *WIFI_PASS = "YOUR_WIFI_PASSWORD";

// Sensor API Key — clients must send this in the X-Api-Key header.
// At least 8 characters, or leave empty ("") to disable the key check
// (then any client connects, e.g. the ESP32-CAM app without a key).
const char *API_KEY = "your-sensor-api-key";

// Host name for this camera node (shown in the Sensor Tester app scan list)
const char *HOSTNAME = "ESP32-CAM-WS";

#endif
