/*
 * secrets.h - Configuration for Sensor Tester LED Node.
 *
 * Instructions:
 * 1. Copy this file to esp32_led/secrets.h
 * 2. Enter your real credentials below.
 *
 * Note: the LED node uses ws:// (no TLS), so unlike the environment-sensor
 * sketches it needs no SERVER_CERT / SERVER_KEY.
 */

#ifndef SECRETS_H
#define SECRETS_H

// WiFi Configuration
const char* WIFI_SSID = "YOUR_WIFI_SSID";
const char* WIFI_PASS = "YOUR_WIFI_PASSWORD";

// Sensor API Key — clients must send this in the X-Api-Key header
const char* API_KEY = "your-sensor-api-key";  // At least 8 characters

// Host name for this LED node (shown in the Sensor Tester app scan list)
const char* HOSTNAME = "ESP32";

#endif
