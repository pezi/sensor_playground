/*
 * secrets.h - Configuration for the Sensor Tester ESP32-CAM node.
 *
 * Instructions:
 * 1. Copy this file to CameraWebServer/secrets.h
 * 2. Enter your real credentials below.
 *
 * Note: the camera serves plain HTTP without an API key (it is the
 * stock Espressif CameraWebServer example), so unlike the sensor
 * sketches it needs no API_KEY and no SERVER_CERT / SERVER_KEY.
 */

#ifndef SECRETS_H
#define SECRETS_H

// WiFi Configuration
const char *WIFI_SSID = "YOUR_WIFI_SSID";
const char *WIFI_PASS = "YOUR_WIFI_PASSWORD";

// Host name for this camera node (shown in the Sensor Tester app scan list)
const char *HOSTNAME = "ESP32-CAM";

#endif
